# Set APP_NAME and APP_URL per deployment; neither is profile-derived.
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Set only when a deployment explicitly needs wider scope. `null` is host-only.
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

IDENTITY_TOMBSTONE_RETENTION_DAYS=30

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Identity-provider deployment profile: bherila (default) or resource.
AUTH_MANAGER_PROFILE=bherila
# The resource profile requires explicit deployment-specific issuer and resource URLs.
# Bherila may also override its APP_URL-derived defaults.
# AUTH_MANAGER_OAUTH_ISSUER=https://identity.example.test
# AUTH_MANAGER_OAUTH_RESOURCE=https://resource.example.test/mcp
# AUTH_MANAGER_THEME_COOKIE_DOMAIN=.example.test
# AUTH_MANAGER_THEME_ALLOWED_HOSTS=example.test

# WebAuthn stays deployment-configured rather than profile-derived.
# WEBAUTHN_RP_NAME="${APP_NAME}"
# WEBAUTHN_RP_ID=
# WEBAUTHN_ALLOWED_ORIGINS=

# RFC 7662 uses Basic authentication. Store only password_hash() output;
# never put the plaintext introspection password in this file or configuration.
# AUTH_MANAGER_INTROSPECTION_CLIENT_ID=
# AUTH_MANAGER_INTROSPECTION_SECRET_HASH=
